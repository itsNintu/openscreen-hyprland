+bool CScreencopyPortal::SSession::setupCursorMetadata() {
+    const auto& WL = g_pPortalManager->m_sWaylandConnection;
+
+    if (!WL.imageCopyMgr || !WL.outputSourceMgr || !WL.pointer) {
+        Debug::log(LOG, "[screencopy] cursor metadata: compositor lacks ext-image-copy-capture or no pointer");
+        return false;
+    }
+
+    if (selection.type != TYPE_OUTPUT && selection.type != TYPE_GEOMETRY && selection.type != TYPE_WINDOW) {
+        Debug::log(LOG, "[screencopy] cursor metadata: selection type {} not supported", (int)selection.type);
+        return false;
+    }
+
+    cursorMeta         = {};
+    cursorMeta.offsetX = 0;
+    cursorMeta.offsetY = 0;
+
+    if (selection.type == TYPE_WINDOW) {
+        if (!setupToplevelCursorSource())
+            return false;
+    } else {
+        const auto POUTPUT = g_pPortalManager->getOutputFromName(selection.output);
+        if (!POUTPUT)
+            return false;
+
+        // cursor positions and the region both arrive in logical output coordinates; frames are buffer px
+        outputPixelScale(POUTPUT, cursorMeta.scaleX, cursorMeta.scaleY);
+        if (selection.type == TYPE_GEOMETRY) {
+            cursorMeta.offsetX = std::round(selection.x * cursorMeta.scaleX);
+            cursorMeta.offsetY = std::round(selection.y * cursorMeta.scaleY);
+        }
+
+        cursorMeta.source = makeShared<CCExtImageCaptureSourceV1>(WL.outputSourceMgr->sendCreateSource(POUTPUT->output->resource()));
+    }
+
+    cursorMeta.session = makeShared<CCExtImageCopyCaptureCursorSessionV1>(WL.imageCopyMgr->sendCreatePointerCursorSession(cursorMeta.source->resource(), WL.pointer->resource()));
+
+    if (!cursorMeta.source || !cursorMeta.session) {
+        teardownCursorMetadata();
+        return false;
+    }
+
+    cursorMeta.session->setEnter([this, self = self](CCExtImageCopyCaptureCursorSessionV1* r) {
+        if (!self)
+            return;
+        cursorMeta.inside = true;
+    });
+    cursorMeta.session->setLeave([this, self = self](CCExtImageCopyCaptureCursorSessionV1* r) {
+        if (!self)
+            return;
+        cursorMeta.inside = false;
+    });
+    cursorMeta.session->setPosition([this, self = self](CCExtImageCopyCaptureCursorSessionV1* r, int32_t x, int32_t y) {
+        if (!self)
+            return;
+        cursorMeta.x          = x;
+        cursorMeta.y          = y;
+        cursorMeta.positioned = true;
+        Debug::log(TRACE, "[screencopy] cursor position {} {}", x, y);
+    });
+    cursorMeta.session->setHotspot([this, self = self](CCExtImageCopyCaptureCursorSessionV1* r, int32_t x, int32_t y) {
+        if (!self)
+            return;
+        cursorMeta.hotX = x;
+        cursorMeta.hotY = y;
+    });
+
+    if (selection.type == TYPE_WINDOW) {
+        for (auto& o : g_pPortalManager->getAllOutputs()) {
+            auto oc     = std::make_unique<decltype(cursorMeta)::SOutputCursor>();
+            auto* OC    = oc.get();
+            oc->output  = o.get();
+            oc->source  = makeShared<CCExtImageCaptureSourceV1>(WL.outputSourceMgr->sendCreateSource(o->output->resource()));
+            oc->session = makeShared<CCExtImageCopyCaptureCursorSessionV1>(WL.imageCopyMgr->sendCreatePointerCursorSession(oc->source->resource(), WL.pointer->resource()));
+            oc->session->setEnter([this, self = self, OC](CCExtImageCopyCaptureCursorSessionV1* r) {
+                if (!self)
+                    return;
+                OC->inside = true;
+            });
+            oc->session->setLeave([this, self = self, OC](CCExtImageCopyCaptureCursorSessionV1* r) {
+                if (!self)
+                    return;
+                OC->inside = false;
+            });
+            oc->session->setPosition([this, self = self, OC](CCExtImageCopyCaptureCursorSessionV1* r, int32_t x, int32_t y) {
+                if (!self)
+                    return;
+                OC->x          = x;
+                OC->y          = y;
+                OC->positioned = true;
+                cursorMeta.refreshWindowGeometry(false);
+            });
+            cursorMeta.outputs.emplace_back(std::move(oc));
+        }
+        cursorMeta.refreshWindowGeometry(true);
+    }
+
+    Debug::log(LOG, "[screencopy] cursor metadata enabled (type {}, output {}, region offset {} {})", (int)selection.type, selection.output, cursorMeta.offsetX,
+               cursorMeta.offsetY);
+    return true;
+}
+
+bool CScreencopyPortal::SSession::setupToplevelCursorSource() {
+    // The picker hands us a wlr foreign-toplevel handle, but capture sources need an ext one.
+    // Hyprland's toplevel-mapping protocol resolves both to a window address, which links them.
+    auto&      WL      = g_pPortalManager->m_sWaylandConnection;
+    const auto MAPPING = g_pPortalManager->m_sHelpers.toplevelMapping ? g_pPortalManager->m_sHelpers.toplevelMapping->manager() : nullptr;
+
+    if (!WL.toplevelSourceMgr || !WL.extToplevelListName || !MAPPING || !selection.windowHandle) {
+        Debug::log(LOG, "[screencopy] cursor metadata: missing toplevel capture/mapping support");
+        return false;
+    }
+
+    auto list = makeShared<CCExtForeignToplevelListV1>(
+        (wl_proxy*)wl_registry_bind((wl_registry*)WL.registry->resource(), WL.extToplevelListName, &ext_foreign_toplevel_list_v1_interface, 1u));
+
+    std::vector<SP<CCExtForeignToplevelHandleV1>> handles;
+    list->setToplevel([&handles](CCExtForeignToplevelListV1* r, wl_proxy* h) { handles.emplace_back(makeShared<CCExtForeignToplevelHandleV1>(h)); });
+    wl_display_roundtrip(WL.display);
+
+    // resolve addresses: the selected window, and every ext handle
+    uint64_t              target = 0;
+    std::vector<uint64_t> addresses(handles.size(), 0);
+    std::vector<SP<CCHyprlandToplevelWindowMappingHandleV1>> requests;
+
+    auto                  targetReq = makeShared<CCHyprlandToplevelWindowMappingHandleV1>(MAPPING->sendGetWindowForToplevelWlr(selection.windowHandle->resource()));
+    targetReq->setWindowAddress([&target](CCHyprlandToplevelWindowMappingHandleV1* r, uint32_t hi, uint32_t lo) { target = (uint64_t)hi << 32 | lo; });
+    requests.push_back(targetReq);
+
+    for (size_t i = 0; i < handles.size(); ++i) {
+        auto req = makeShared<CCHyprlandToplevelWindowMappingHandleV1>(MAPPING->sendGetWindowForToplevel(handles[i]->resource()));
+        req->setWindowAddress([&addresses, i](CCHyprlandToplevelWindowMappingHandleV1* r, uint32_t hi, uint32_t lo) { addresses[i] = (uint64_t)hi << 32 | lo; });
+        requests.push_back(req);
+    }
+    wl_display_roundtrip(WL.display);
+    requests.clear();
+
+    // later toplevel announcements are not needed; drop them instead of touching the dead locals above
+    list->setToplevel([](CCExtForeignToplevelListV1* r, wl_proxy* h) { makeShared<CCExtForeignToplevelHandleV1>(h); });
+
+    SP<CCExtForeignToplevelHandleV1> match;
+    for (size_t i = 0; i < handles.size() && target; ++i) {
+        if (addresses[i] == target) {
+            match = handles[i];
+            break;
+        }
+    }
+
+    if (!match) {
+        Debug::log(LOG, "[screencopy] cursor metadata: no ext toplevel matches window {:x} ({} candidates)", target, handles.size());
+        return false;
+    }
+
+    cursorMeta.toplevelList   = list;
+    cursorMeta.toplevelHandle = match;
+    cursorMeta.source         = makeShared<CCExtImageCaptureSourceV1>(WL.toplevelSourceMgr->sendCreateSource(match->resource()));
+    cursorMeta.windowAddress = target;
+    Debug::log(LOG, "[screencopy] cursor metadata: tracking window {:x}", target);
+    return true;
+}
+
+void CScreencopyPortal::SSession::teardownCursorMetadata() {
+    cursorMeta.outputs.clear();
+    cursorMeta.windowValid = false;
+    cursorMeta.session.reset();
+    cursorMeta.source.reset();
+    cursorMeta.toplevelHandle.reset();
+    cursorMeta.toplevelList.reset();
+    cursorMeta.inside     = false;
+    cursorMeta.positioned = false;
+}
