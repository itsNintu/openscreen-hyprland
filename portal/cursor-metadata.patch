+// Hyprland's ext-image-copy-capture cursor sessions report positions in logical px relative to the source's
+// logical box (the protocol asks for buffer px relative to the captured buffer). Output sources therefore give
+// global logical coordinates once the output's logical position is added, which is what everything here uses.
+static bool outputLogicalBox(const SOutput* o, double& x, double& y, double& w, double& h) {
+    x = o->logicalX;
+    y = o->logicalY;
+    if (o->logicalSizeValid && o->logicalWidth > 0 && o->logicalHeight > 0) {
+        w = o->logicalWidth;
+        h = o->logicalHeight;
+    } else {
+        const bool ROTATED = o->transform % 2 == 1;
+        w                  = (ROTATED ? o->height : o->width) / o->scale;
+        h                  = (ROTATED ? o->width : o->height) / o->scale;
+    }
+    return w > 0 && h > 0;
+}
+
+bool CScreencopyPortal::SSession::SCursorMeta::pointerInArea(double& x, double& y) const {
+    if (!areaValid)
+        return false;
+    for (const auto& oc : outputs) {
+        double ox, oy, ow, oh;
+        // a session "enters" as soon as the cursor image touches the output; the hotspot decides which one it's on
+        if (!oc->inside || !outputLogicalBox(oc->output, ox, oy, ow, oh) || oc->x < 0 || oc->y < 0 || oc->x >= ow || oc->y >= oh)
+            continue;
+        x = ox + oc->x - areaX;
+        y = oy + oc->y - areaY;
+        return x >= 0 && y >= 0 && x < areaW && y < areaH;
+    }
+    return false;
+}
+
+// No Wayland protocol tells a client where a window is, so window shares ask Hyprland's IPC for the window's
+// position and size, at most every 100ms while the pointer moves. That follows a window moved or resized
+// mid-recording.
+void CScreencopyPortal::SSession::SCursorMeta::refreshWindowArea(bool force) {
+    const auto NOW = std::chrono::steady_clock::now();
+    if (!windowAddress || (!force && NOW - windowQueried < std::chrono::milliseconds(100)))
+        return;
+    windowQueried = NOW;
+
+    const char* XDG = getenv("XDG_RUNTIME_DIR");
+    const char* HIS = getenv("HYPRLAND_INSTANCE_SIGNATURE");
+    if (!XDG || !HIS)
+        return;
+
+    sockaddr_un addr = {.sun_family = AF_UNIX};
+    snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/hypr/%s/.socket.sock", XDG, HIS);
+    const int FD = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (FD < 0)
+        return;
+    const timeval TIMEOUT = {.tv_sec = 0, .tv_usec = 200000};
+    setsockopt(FD, SOL_SOCKET, SO_RCVTIMEO, &TIMEOUT, sizeof(TIMEOUT));
+    setsockopt(FD, SOL_SOCKET, SO_SNDTIMEO, &TIMEOUT, sizeof(TIMEOUT));
+    std::string reply;
+    if (connect(FD, (sockaddr*)&addr, sizeof(addr)) == 0 && write(FD, "clients", 7) == 7) {
+        char    buf[8192];
+        ssize_t n;
+        while ((n = read(FD, buf, sizeof(buf))) > 0)
+            reply.append(buf, n);
+    }
+    close(FD);
+
+    // "Window <hex address> -> <title>:" followed by tab-indented "key: value" lines
+    const auto START = reply.find(std::format("Window {:x} -> ", windowAddress));
+    if (START == std::string::npos)
+        return;
+    const auto END   = reply.find("\nWindow ", START + 1);
+    const auto BLOCK = reply.substr(START, END == std::string::npos ? std::string::npos : END - START);
+    const auto AT = BLOCK.find("\n\tat: "), SIZE = BLOCK.find("\n\tsize: ");
+    double     x, y, w, h;
+    if (AT == std::string::npos || SIZE == std::string::npos || sscanf(BLOCK.c_str() + AT, "\n\tat: %lf,%lf", &x, &y) != 2 ||
+        sscanf(BLOCK.c_str() + SIZE, "\n\tsize: %lf,%lf", &w, &h) != 2 || w <= 0 || h <= 0)
+        return;
+
+    if (!areaValid || x != areaX || y != areaY || w != areaW || h != areaH)
+        Debug::log(LOG, "[screencopy] cursor metadata: window at {},{} size {}x{}", x, y, w, h);
+    areaX = x, areaY = y, areaW = w, areaH = h;
+    areaValid = true;
+}
+
+bool CScreencopyPortal::SSession::setupCursorMetadata() {
+    const auto& WL = g_pPortalManager->m_sWaylandConnection;
+
+    if (!WL.imageCopyMgr || !WL.outputSourceMgr || !WL.pointer) {
+        Debug::log(LOG, "[screencopy] cursor metadata: compositor lacks ext-image-copy-capture or no pointer");
+        return false;
+    }
+
+    teardownCursorMetadata();
+
+    switch (selection.type) {
+        case TYPE_OUTPUT:
+        case TYPE_GEOMETRY: {
+            const auto POUTPUT = g_pPortalManager->getOutputFromName(selection.output);
+            if (!POUTPUT || !outputLogicalBox(POUTPUT, cursorMeta.areaX, cursorMeta.areaY, cursorMeta.areaW, cursorMeta.areaH))
+                return false;
+            if (selection.type == TYPE_GEOMETRY) {
+                // the region is in logical coordinates relative to its output
+                cursorMeta.areaX += selection.x;
+                cursorMeta.areaY += selection.y;
+                cursorMeta.areaW = selection.w;
+                cursorMeta.areaH = selection.h;
+            }
+            cursorMeta.areaValid = true;
+            break;
+        }
+        case TYPE_WINDOW: {
+            const auto& MAPPING = g_pPortalManager->m_sHelpers.toplevelMapping;
+            cursorMeta.windowAddress = MAPPING && selection.windowHandle ? MAPPING->getWindowForToplevel(selection.windowHandle) : 0;
+            cursorMeta.refreshWindowArea(true);
+            if (!cursorMeta.areaValid) {
+                Debug::log(LOG, "[screencopy] cursor metadata: couldn't locate window {:x}", cursorMeta.windowAddress);
+                return false;
+            }
+            break;
+        }
+        default: Debug::log(LOG, "[screencopy] cursor metadata: selection type {} not supported", (int)selection.type); return false;
+    }
+
+    for (const auto& o : g_pPortalManager->getAllOutputs()) {
+        auto oc     = std::make_unique<SCursorMeta::SOutputCursor>();
+        auto PCURSOR = oc.get();
+        oc->output  = o.get();
+        oc->source  = makeShared<CCExtImageCaptureSourceV1>(WL.outputSourceMgr->sendCreateSource(o->output->resource()));
+        oc->session = makeShared<CCExtImageCopyCaptureCursorSessionV1>(WL.imageCopyMgr->sendCreatePointerCursorSession(oc->source->resource(), WL.pointer->resource()));
+        oc->session->setEnter([PCURSOR](CCExtImageCopyCaptureCursorSessionV1* r) { PCURSOR->inside = true; });
+        oc->session->setLeave([PCURSOR](CCExtImageCopyCaptureCursorSessionV1* r) { PCURSOR->inside = false; });
+        oc->session->setPosition([this, PCURSOR](CCExtImageCopyCaptureCursorSessionV1* r, int32_t x, int32_t y) {
+            PCURSOR->x = x;
+            PCURSOR->y = y;
+            cursorMeta.refreshWindowArea(false);
+        });
+        cursorMeta.outputs.emplace_back(std::move(oc));
+    }
+
+    Debug::log(LOG, "[screencopy] cursor metadata enabled (type {}, area {},{} {}x{})", (int)selection.type, cursorMeta.areaX, cursorMeta.areaY, cursorMeta.areaW,
+               cursorMeta.areaH);
+    return true;
+}
+
+void CScreencopyPortal::SSession::teardownCursorMetadata() {
+    cursorMeta.outputs.clear(); // destroys the sessions, so no callback outlives this
+    cursorMeta.areaValid     = false;
+    cursorMeta.windowAddress = 0;
+}
