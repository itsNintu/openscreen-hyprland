+// Window geometry (global logical "at" and "size") from Hyprland's IPC, at most every 100ms while the
+// pointer moves, so moving/resizing the window during a recording is followed.
+void CScreencopyPortal::SSession::SCursorMeta::refreshWindowGeometry(bool force) {
+    const auto NOW = std::chrono::steady_clock::now();
+    if (!windowAddress || (!force && NOW - windowQueried < std::chrono::milliseconds(100)))
+        return;
+    windowQueried = NOW;
+
+    const char* XDG = getenv("XDG_RUNTIME_DIR");
+    const char* HIS = getenv("HYPRLAND_INSTANCE_SIGNATURE");
+    if (!XDG || !HIS)
+        return;
+    const std::string PATH = std::string{XDG} + "/hypr/" + HIS + "/.socket.sock";
+
+    int               fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return;
+    sockaddr_un addr = {.sun_family = AF_UNIX};
+    strncpy(addr.sun_path, PATH.c_str(), sizeof(addr.sun_path) - 1);
+    timeval tv = {.tv_sec = 0, .tv_usec = 200000};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    std::string reply;
+    if (connect(fd, (sockaddr*)&addr, sizeof(addr)) == 0 && write(fd, "clients", 7) == 7) {
+        char    buf[8192];
+        ssize_t n;
+        while ((n = read(fd, buf, sizeof(buf))) > 0)
+            reply.append(buf, n);
+    }
+    close(fd);
+
+    char head[64];
+    snprintf(head, sizeof(head), "Window %lx -> ", (unsigned long)windowAddress);
+    auto start = reply.find(head);
+    if (start == std::string::npos)
+        return;
+    auto       end   = reply.find("\nWindow ", start + 1);
+    const auto BLOCK = reply.substr(start, end == std::string::npos ? std::string::npos : end - start);
+    double     ax = 0, ay = 0, sw = 0, sh = 0;
+    const auto AT = BLOCK.find("\tat: "), SIZE = BLOCK.find("\tsize: ");
+    if (AT == std::string::npos || SIZE == std::string::npos || sscanf(BLOCK.c_str() + AT, "\tat: %lf,%lf", &ax, &ay) != 2 ||
+        sscanf(BLOCK.c_str() + SIZE, "\tsize: %lf,%lf", &sw, &sh) != 2 || sw <= 0 || sh <= 0)
+        return;
+    if (!windowValid || ax != winX || ay != winY || sw != winW || sh != winH)
+        Debug::log(LOG, "[screencopy] cursor metadata: window at {},{} size {}x{}", ax, ay, sw, sh);
+    winX = ax, winY = ay, winW = sw, winH = sh;
+    windowValid = true;
+}
