+// buffer px per logical px of an output
+static void outputPixelScale(const SOutput* o, double& sx, double& sy) {
+    const bool   ROTATED = o->transform % 2 == 1;
+    const double PXW     = ROTATED ? o->height : o->width;
+    const double PXH     = ROTATED ? o->width : o->height;
+    sx                   = o->logicalSizeValid && o->logicalWidth > 0 ? PXW / o->logicalWidth : o->scale;
+    sy                   = o->logicalSizeValid && o->logicalHeight > 0 ? PXH / o->logicalHeight : o->scale;
+}
