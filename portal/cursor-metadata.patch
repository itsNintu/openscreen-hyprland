+    spa_meta_cursor* cursor = (spa_meta_cursor*)spa_buffer_find_meta_data(spaBuf, SPA_META_Cursor, sizeof(*cursor));
+    if (cursor) {
+        const auto& CM = pSession->cursorMeta;
+        const uint32_t FW = pSession->sharingData.frameInfoDMA.w ? pSession->sharingData.frameInfoDMA.w : pSession->sharingData.frameInfoSHM.w;
+        const uint32_t FH = pSession->sharingData.frameInfoDMA.h ? pSession->sharingData.frameInfoDMA.h : pSession->sharingData.frameInfoSHM.h;
+        // window shares: pointer (global logical) against the window's own rect; menus/popups over it count
+        int32_t viaOutX = 0, viaOutY = 0;
+        bool    viaOutput = false;
+        if (pSession->selection.type == TYPE_WINDOW && CM.windowValid) {
+            for (const auto& o : CM.outputs) {
+                if (!o->inside || !o->positioned)
+                    continue;
+                const double RX = o->output->logicalX + o->x - CM.winX, RY = o->output->logicalY + o->y - CM.winY;
+                if (RX >= 0 && RY >= 0 && RX < CM.winW && RY < CM.winH) {
+                    viaOutX   = std::round(RX * FW / CM.winW);
+                    viaOutY   = std::round(RY * FH / CM.winH);
+                    viaOutput = true;
+                }
+                break;
+            }
+        }
+        const bool WINDOW = pSession->selection.type == TYPE_WINDOW;
+        const double sx = CM.scaleX, sy = CM.scaleY;
+        if (pSession->cursorMode == METADATA && CM.session && (CM.positioned || viaOutput || (WINDOW && CM.windowValid))) {
+            cursor->id = 1;
+            cursor->flags = 0;
+            if (WINDOW) {
+                cursor->position.x = viaOutput ? viaOutX : -1;
+                cursor->position.y = viaOutput ? viaOutY : -1;
+            } else if (CM.inside) {
+                cursor->position.x = (int32_t)std::round(CM.x * sx) - CM.offsetX;
+                cursor->position.y = (int32_t)std::round(CM.y * sy) - CM.offsetY;
+            } else {
+                // pointer is on another output: report it outside the frame
+                cursor->position.x = -1;
+                cursor->position.y = -1;
+            }
+            cursor->hotspot.x     = CM.hotX;
+            cursor->hotspot.y     = CM.hotY;
+            cursor->bitmap_offset = 0; // no bitmap yet; consumers draw their own cursor
+            Debug::log(TRACE, "[pw]  | cursor {} {} inside {}", cursor->position.x, cursor->position.y, CM.inside);
+        } else
+            cursor->id = 0; // invalid: no cursor info for this buffer
+    }
+
     spa_data* datas = spaBuf->datas;
 
     Debug::log(TRACE, "[pw]  | size {}x{}", PSTREAM->pSession->sharingData.frameInfoDMA.w, PSTREAM->pSession->sharingData.frameInfoDMA.h);
